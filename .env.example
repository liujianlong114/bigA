# MySQL（本地默认 root 无密码，库名 biga 会自动创建）
MYSQL_DSN=root@tcp(127.0.0.1:3306)/biga?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 模拟盘
SIM_INITIAL_CASH=1000000
SIM_RELAX_HOURS=true
HTTP_ADDR=:8080

# Marvis 编排器（30 分钟巡检）
MARVIS_INTERVAL=30m
MARVIS_BASE_URL=http://localhost:8080
MARVIS_FLUTTER_URL=http://localhost:3000
MARVIS_START_FLUTTER=true
# MARVIS_ONCE=1  单次巡检后退出
